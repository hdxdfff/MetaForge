FROM debian:13-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
    gcc \
    gcc-multilib \
    libc6-dev-i386 \
    binutils \
    nasm \
    make \
    python3 \
    qemu-system-x86 \
    grub-pc-bin \
    xorriso \
    mtools \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /codex/generated/toy-os-demo
