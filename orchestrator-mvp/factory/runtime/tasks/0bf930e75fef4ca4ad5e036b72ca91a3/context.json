    "project_context": {
      "name": "ToyOS Kernel",
      "summary": "Kernel prototype under active assistant-led development with TinyFS, syscalls, scheduler, QEMU-verified boot, and reusable VM smoke testing.",
      "repo_path": "D:\\codex\\generated\\toy-os-demo",
      "project_goals": [
        "Keep the default ToyOS boot path stable under repeated QEMU smoke and soak tests.",
        "Evolve ToyOS toward a stronger thesis-grade x86 teaching kernel with user mode, syscalls, scheduling, and filesystem support.",
        "Prefer incremental subsystem upgrades that preserve a working kernel after each verified change."
      ],
      "technical_constraints": [
        "Default verification must remain WSL plus QEMU based before any bare-metal claims.",
        "Kernel changes should preserve a compiling and bootable default path after each patch.",
        "High-risk architectural changes should be isolated and verified before enabling them in the stable boot path."
      ],
      "architecture_decisions": [
        "Treat the current default path as a stable ring3-plus-syscall teaching kernel rather than a production OS.",
        "Keep paging implemented but disabled in the default boot path until full context restoration is ready.",
        "Use TinyFS over a RAM-backed block device and keep QEMU regression as the primary runtime truth source."
      ],
      "working_agreements": [
        "Use local tools first",
        "Keep ToyOS compiling after each change",
        "Run VM smoke tests before claiming runtime stability",
        "Escalate to the core model only for failed tests, unsafe low-level transitions, or structural kernel changes"
      ],
      "recent_decisions": [
        "Use TinyFS on top of ramdisk",
        "Use generic_test_runner.py for repeated local regression runs",
        "Default ToyOS runtime verification to QEMU rather than bare metal",
        "Treat assistant-led WSL plus QEMU workflow as the default development path"
      ]
    },
